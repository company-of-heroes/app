{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Company of Heroes - Companion app",
	"version": "0.63.0",
	"identifier": "com.fknoobscoh.app",
	"build": {
		"beforeDevCommand": "pnpm dev:web",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "Company of Heroes - Companion app",
				"label": "main",
				"width": 1800,
				"height": 1000,
				"transparent": false,
				"backgroundColor": "#3e3e3f",
				"dragDropEnabled": false,
				"url": "/splashscreen",
				"titleBarStyle": "Overlay"
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": ["$APPDATA/**"]
			}
		},
		"withGlobalTauri": true,
		"trayIcon": {
			"id": "main",
			"iconPath": "icons/32x32.png",
			"iconAsTemplate": false,
			"tooltip": "Company of Heroes - Companion",
			"showMenuOnLeftClick": false
		}
	},
	"bundle": {
		"active": true,
		"publisher": "Code IT Ninja",
		"copyright": "Copyright © Code IT Ninja",
		"createUpdaterArtifacts": true,
		"targets": ["nsis", "msi"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"wix": {
				"upgradeCode": "150f36d8-1af5-52f1-abfe-be2492789607"
			},
			"nsis": {
				"installMode": "currentUser"
			}
		}
	},
	"plugins": {
		"tauri-plugin-http": {
			"dangerousDisableDnsLookup": true,
			"dangerousDisableHostValidation": true,
			"dangerousAllowHttpOnProduction": true,
			"dangerousAcceptInvalidCerts": true
		},
		"sql": {
			"preload": ["sqlite:app.dev.db"]
		},
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2Mzc3RDBEM0FBOEVEOTEKUldTUjdhZzZEWDAzeHZ6d053OUNpTXdlQmllVzN0bklqOGEySjRsRlpvTVVLTDNsb08wMWxuVGYK",
			"endpoints": [
				"https://github.com/fknoobs/app/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
