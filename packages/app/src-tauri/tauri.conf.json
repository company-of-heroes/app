{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Company of Heroes - Companion app",
	"version": "0.66.1",
	"identifier": "com.fknoobscoh.app",
	"build": {
		"beforeDevCommand": "pnpm dev:web",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "Company of Heroes - Companion app",
				"label": "main",
				"width": 1800,
				"height": 1000,
				"transparent": false,
				"backgroundColor": "#3e3e3f",
				"dragDropEnabled": false,
				"url": "/splashscreen",
				"titleBarStyle": "Overlay"
			}
		],
		"security": {
			"csp": {
				"default-src": "'self' ipc: http://ipc.localhost",
				"script-src": "'self' 'wasm-unsafe-eval'",
				"style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
				"font-src": "'self' data: https://fonts.gstatic.com",
				"img-src": "'self' asset: http://asset.localhost data: blob: https: http://localhost:* http://127.0.0.1:*",
				"media-src": "'self' asset: http://asset.localhost data: blob: https:",
				"connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost data: blob: https: wss: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*",
				"frame-src": "https: http://localhost:* http://127.0.0.1:*",
				"worker-src": "'self' blob:",
				"object-src": "'none'",
				"base-uri": "'self'"
			},
			"devCsp": null,
			"dangerousDisableAssetCspModification": ["style-src"],
			"assetProtocol": {
				"enable": true,
				"scope": ["$APPDATA/**"]
			}
		},
		"withGlobalTauri": false,
		"trayIcon": {
			"id": "main",
			"iconPath": "icons/32x32.png",
			"iconAsTemplate": false,
			"tooltip": "Company of Heroes - Companion",
			"showMenuOnLeftClick": false
		}
	},
	"bundle": {
		"active": true,
		"publisher": "Code IT Ninja",
		"copyright": "Copyright © Code IT Ninja",
		"createUpdaterArtifacts": true,
		"targets": ["nsis", "msi"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"wix": {
				"upgradeCode": "150f36d8-1af5-52f1-abfe-be2492789607"
			},
			"nsis": {
				"installMode": "currentUser"
			}
		}
	},
	"plugins": {
		"tauri-plugin-http": {
			"dangerousDisableDnsLookup": true,
			"dangerousDisableHostValidation": true,
			"dangerousAllowHttpOnProduction": true,
			"dangerousAcceptInvalidCerts": true
		},
		"sql": {
			"preload": ["sqlite:app.dev.db"]
		},
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2Mzc3RDBEM0FBOEVEOTEKUldTUjdhZzZEWDAzeHZ6d053OUNpTXdlQmllVzN0bklqOGEySjRsRlpvTVVLTDNsb08wMWxuVGYK",
			"endpoints": ["https://github.com/fknoobs/app/releases/latest/download/latest.json"],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
