# Local PocketBase (used by `pnpm dev` / `vite dev`).
# Use 127.0.0.1 rather than localhost: on Windows localhost resolves to ::1
# first, while Docker only publishes on IPv4, which adds a retry per request.
PUBLIC_PB_URL=http://127.0.0.1:8090
# Local landing (packages/landing uses Vite port 5174).
PUBLIC_SITE_URL=http://127.0.0.1:5174
PUBLIC_STEAM_API_KEY=

# Production builds (`pnpm build`) load `.env.production` instead,
# which sets PUBLIC_PB_URL / PUBLIC_SITE_URL to the live hosts.
