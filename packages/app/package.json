{
	"name": "@company-of-heroes/app",
	"version": "0.63.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node ./scripts/tauri.mjs dev",
		"dev:web": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"tauri": "node ./scripts/tauri.mjs",
		"tauri:build:linux": "node ./scripts/tauri.mjs build --bundles appimage --target x86_64-unknown-linux-gnu",
		"tauri:build:macos": "tauri build --target x86_64-apple-darwin",
		"tauri:build:windows": "tauri build --target x86_64-pc-windows-msvc",
		"pocketbase:typegen": "npx pocketbase-typegen --env --out src/lib/core/pocketbase/types.ts",
		"replays:reparse": "node ./scripts/fix-replays.mjs"
	},
