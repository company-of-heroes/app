{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Company of Heroes - Replay Manager",
	"version": "1.0.0",
	"identifier": "com.fknoobscoh.replayparser",
	"build": {
		"beforeDevCommand": "pnpm dev:web",
		"devUrl": "http://localhost:1430",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "Company of Heroes - Replay Manager",
				"label": "main",
				"width": 320,
				"height": 380,
				"center": true,
				"resizable": false,
				"maximizable": false,
				"decorations": false,
				"backgroundColor": "#3e3e3f",
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": {
				"default-src": "'self' ipc: http://ipc.localhost",
				"script-src": "'self' 'wasm-unsafe-eval'",
				"style-src": "'self' 'unsafe-inline'",
				"font-src": "'self' data:",
				"img-src": "'self' data: blob:",
				"connect-src": "'self' ipc: http://ipc.localhost https://api.github.com",
				"worker-src": "'self' blob:",
				"object-src": "'none'",
				"base-uri": "'self'"
			},
			"devCsp": null,
			"dangerousDisableAssetCspModification": ["style-src"]
		},
		"withGlobalTauri": false
	},
	"bundle": {
		"active": true,
		"publisher": "Code IT Ninja",
		"copyright": "Copyright © Code IT Ninja",
		"targets": ["nsis", "msi"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"wix": {
				"upgradeCode": "7d4a2c51-9b3e-4f6a-8c21-5e0b3f9a6d17"
			},
			"nsis": {
				"installMode": "currentUser"
			}
		}
	}
}
