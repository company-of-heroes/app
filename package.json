{
	"name": "fknoobscoh-workspace",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@9.15.9",
	"scripts": {
		"dev": "turbo run dev --filter=@company-of-heroes/pocketbase --filter=@company-of-heroes/app",
		"build": "pnpm --filter app tauri build",
		"pb:up": "pnpm --filter pocketbase serve",
		"pb:down": "pnpm --filter pocketbase down",
		"overlays:dev": "pnpm --filter @company-of-heroes/oppbot-overlay dev",
		"overlays:build": "turbo run build --filter=@company-of-heroes/oppbot-overlay",
		"oppbot:build": "turbo run build --filter=@company-of-heroes/oppbot-overlay",
		"website:dev": "pnpm --filter @company-of-heroes/website dev",
		"website:build": "turbo run build --filter=@company-of-heroes/website",
		"check": "turbo run check",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"changeset": "changeset",
		"version-packages": "node scripts/version.mjs",
		"release": "changeset publish"
	},
	"license": "MIT",
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"prettier": "3.7.4",
		"prettier-plugin-curly": "0.4.1",
		"prettier-plugin-svelte": "3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"turbo": "^2.10.12"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		],
		"overrides": {
			"svelte": "^5.57.0"
		}
	}
}
